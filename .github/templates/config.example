# Dependency Updater - Configuration Template
# Copy this file to ~/.dependency-updater.config and customize for your project
# Generated on: November 17, 2025

# ============================================================================
# LANGUAGE SUPPORT - Enable/disable specific languages
# ============================================================================

ENABLE_NODEJS=true
ENABLE_PYTHON=true
ENABLE_DOCKER=true
ENABLE_JAVA=false
ENABLE_GO=false
ENABLE_RUST=false

# ============================================================================
# UPDATE STRATEGY
# ============================================================================

# Options: patch (x.y.Z), minor (x.Y.z), major (X.y.z)
UPDATE_STRATEGY=minor

# ============================================================================
# FEATURES
# ============================================================================

# Run tests after updates
RUN_TESTS=true

# Run security audits (npm audit, pip-audit, cargo audit, etc.)
RUN_SECURITY_AUDIT=true

# Auto-commit changes after update
AUTO_COMMIT=true

# Create pull requests automatically
CREATE_PULL_REQUEST=true

# ============================================================================
# PERFORMANCE
# ============================================================================

# Run language updates in parallel (faster, uses more resources)
PARALLEL_EXECUTION=true

# Maximum number of parallel jobs
MAX_PARALLEL_JOBS=4

# ============================================================================
# GIT CONFIGURATION
# ============================================================================

# Prefix for git branch names (full name: ${prefix}-${timestamp})
GIT_BRANCH_PREFIX=dependency-updates

# Commit message template
GIT_COMMIT_MESSAGE=chore: update dependencies

# ============================================================================
# LOGGING & OUTPUT
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file location (relative or absolute path)
LOG_FILE=dependency-updater.log

# ============================================================================
# DOCKER REGISTRY CONFIGURATION
# ============================================================================

# Docker registries to check: docker-hub, nexus, artifactory
DOCKER_REGISTRIES=docker-hub

# ============================================================================
# ENTERPRISE NEXUS SUPPORT (Optional)
# ============================================================================

# Enable Nexus Docker registry support
NEXUS_ENABLED=false

# Nexus server URL (e.g., https://nexus.company.com)
NEXUS_URL=

# Nexus username (for authentication)
NEXUS_USER=

# Nexus password or API token (for authentication)
NEXUS_PASSWORD=

# ============================================================================
# MONOREPO CONFIGURATION
# ============================================================================

# Enable monorepo support (npm workspaces, Lerna, Go workspaces, etc.)
MONOREPO_ENABLED=false

# Specific monorepo paths to update (comma-separated)
# Example: MONOREPO_PATHS=packages/app,packages/core,services/*
MONOREPO_PATHS=

# ============================================================================
# DEPENDENCY CONFLICTS
# ============================================================================

# Conflict resolution strategy: manual, auto, ignore
# - manual: User must resolve conflicts
# - auto: Automatically attempt resolution
# - ignore: Skip conflict resolution
CONFLICT_RESOLUTION=manual

# ============================================================================
# REPORTING
# ============================================================================

# Generate dependency reports (JSON, CSV, SBOM, Markdown)
GENERATE_REPORTS=true

# Report formats: json, csv, sbom, md (comma-separated)
REPORT_FORMATS=json,csv,md,sbom

# Directory where reports are saved
REPORT_OUTPUT_DIR=./reports

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================

# Enable notifications (slack, email, webhook)
NOTIFICATIONS_ENABLED=false

# Notification type: slack, email, webhook
NOTIFICATION_TYPE=

# Webhook URL for notifications
NOTIFICATION_WEBHOOK=

# ============================================================================
# IGNORING SPECIFIC LANGUAGES
# ============================================================================

# Languages to ignore (comma-separated)
# Example: IGNORE_LANGUAGES=java,go
IGNORE_LANGUAGES=

# ============================================================================
# SECURITY AUDIT TOOLS
# ============================================================================

# Tools for security scanning (auto-detected if installed)
# npm audit - Built into npm
# pip-audit - Install: pip install pip-audit
# cargo audit - Install: cargo install cargo-audit
# govulncheck - Install: go install golang.org/x/vuln/cmd/govulncheck@latest
# trivy - Download: https://github.com/aquasecurity/trivy

ENABLE_TRIVY=false
ENABLE_GOVULNCHECK=false
ENABLE_PIP_AUDIT=false
ENABLE_CARGO_AUDIT=false

# ============================================================================
# TEAM CONFIGURATION
# ============================================================================

# Your team name (for reports and PR descriptions)
TEAM_NAME=

# Default reviewers for PRs (comma-separated GitHub usernames)
DEFAULT_REVIEWERS=

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Skip certain dependency patterns (regex)
# Example: SKIP_DEPENDENCIES=@types/*,test-*
SKIP_DEPENDENCIES=

# Include only specific dependency patterns (regex)
# Example: INCLUDE_DEPENDENCIES=@company/*
INCLUDE_DEPENDENCIES=

# Maximum days since last update (only update if last > N days)
DAYS_SINCE_LAST_UPDATE=0
