{
  "name": "dep-sync",
  "version": "2.1.0",
  "description": "Automated Dependency Updater for Node.js, Python, Docker & Java",
  "main": "dist/index.js",
  "bin": {
    "dep-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "dependency",
    "updater",
    "automation",
    "npm",
    "pip",
    "docker",
    "maven"
  ],
  "author": "DevOps-Busters",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.32",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "prettier": "^3.2.5",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
